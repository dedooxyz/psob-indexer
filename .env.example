# PSob light client / multi-chain indexer — configuration (.env)
# EVERY setting comes from env; sensible defaults provided for local testing.

# Aux chains to ingest. Comma-separated, one chain per entry:
#   NAME|CHAIN_ID|ELECTRS_URL|POWLIMIT_BITS_HEX[|START_HEIGHT]
# (`|` field separator is URL-safe; don't use `:`).
# CHAIN_ID = nVersion >> 16 (e.g. JKC 8224, DINGO 50, LKY 8211, SHIC 74, TRMP 168, CRC 8228, B1T 2840, LBW 8256).
# POWLIMIT_BITS_HEX = consensus powLimit in compact nBits, hex (e.g. 0x1e0fffff).
PSOB_CHAINS=JKC|8224|https://junk-api.s3na.xyz|0x1e0fffff|1095300,DINGO|50|https://dingo-api.s3na.xyz|0x1e0fffff|2717300,LKY|8211|https://lky-api.s3na.xyz|0x1e0fffff|1062050,SHIC|74|https://shic-api.s3na.xyz|0x1e0fffff|835600,TRMP|168|https://trmp-api.s3na.xyz|0x1e0fffff|539900,CRC|8228|https://crc-api.s3na.xyz|0x1e0fffff|1049900,B1T|2840|https://bit-api.s3na.xyz|0x1e0fffff|525650,LBW|8256|https://lbw-api.s3na.xyz|0x1e0fffff|771400

# SQLite cache location (WAL). Local file path.
PSOB_DB_PATH=psob-indexer.sqlite3

# Parent-chain resolver (Esplora API / litecoinspace or ccnodes.net).
# Defaults to https://litecoinspace.org/api (no API key required).
PSOB_CCNODES_BASE=https://litecoinspace.org/api
PSOB_PARENT_CHAIN=litecoin
CCNODES_API_KEY=

# Tuning (optional, bounded, non-security-relevant):
PSOB_MAX_BATCH=64
PSOB_POLL_INTERVAL_SECS=15

# Global start height fallback for fresh DBs if not specified per-chain above:
PSOB_START_HEIGHT=1000000

# Log level filter (RUST_LOG default): psob_indexer=info