# psob-indexer configuration — copy to `.env` (loaded automatically).
# Precedence: `.env` < `psob-indexer.toml` (if present) < process environment.

# ─── Aux chains to ingest ──────────────────────────────────────────────────────
# Comma-separated, one chain per entry:
#   NAME|CHAIN_ID|ELECTRS_URL|POWLIMIT_BITS_HEX[|START_HEIGHT]
# (`|` field separator is URL-safe; don't use `:` — it collides with URLs).
# CHAIN_ID = nVersion >> 16 (JKC 8224, DINGO 50, LKY 8211, SHIC 74, TRMP 168,
#            CRC 8228, B1T 2840, PEP 63, DOGE 98, BELL 156). CHAIN_ID is the
#            CANONICAL identifier used for every DB key and API query; NAME is
#            display-only (trimmed, auto-derived if empty). Two chains may NOT
#            share a CHAIN_ID (startup rejects duplicates).
#
# Adding a chain = one more entry. Everything is config-driven; nothing is
# hardcoded in code. Dogecoin/Bellcoin are AuxPoW-mined BY Litecoin, so they fit
# here as ordinary entries (verify CHAIN_ID/powLimit against that chain's Core;
# the ingest walk starts at START_HEIGHT+1 and works up to the tip):
#   DOGE|98|https://doge-api.s3na.xyz|0x1e0fffff|6300000
#   BELL|156|https://bell-api.s3na.xyz|0x1e0fffff|3300000
# POWLIMIT_BITS_HEX = consensus powLimit compact nBits (e.g. 0x1e0fffff).
# START_HEIGHT (optional, per-chain) = the cursor the walk starts from (the
# walk ingests START_HEIGHT+1 .. tip). A global PSOB_START_HEIGHT is used when
# it is absent.
PSOB_CHAINS=JKC|8224|https://junk-api.s3na.xyz|0x1e0fffff|1095300,DINGO|50|https://dingo-api.s3na.xyz|0x1e0fffff|2717300,LKY|8211|https://lky-api.s3na.xyz|0x1e0fffff|1062050,SHIC|74|https://shic-api.s3na.xyz|0x1e0fffff|835600,TRMP|168|https://trmp-api.s3na.xyz|0x1e0fffff|539900,CRC|8228|https://crc-api.s3na.xyz|0x1e0fffff|1049900,B1T|2840|https://bit-api.s3na.xyz|0x1e0fffff|525650

# ─── Registry-only chains (registered, NEVER ingested) ─────────────────────────
# Same NAME|CHAIN_ID|ELECTRS_URL shape (no powLimit/START_HEIGHT) — these are
# upserted into the chain registry at startup and listed by GET /api/v1/chains
# with "ingested": false, but no ingest task polls them and they are not part
# of PSOB_CHAINS (a duplicate chain_id across the two lists fails startup).
# Litecoin: the PARENT chain (PSOB_PARENT_CHAIN=litecoin) whose 80-byte headers
# carry no AuxPoW witness — it is the settlement anchor for swaps, so it must be
# known to swap validation, but there is nothing AuxPoW to ingest for it.
PSOB_KNOWN_CHAINS=LTC|8192|https://ltc-api.s3na.xyz

# ─── Storage ───────────────────────────────────────────────────────────────────
# Redb cache location (ACID, log-structured).
PSOB_DB_PATH=psob-indexer.redb

# ─── Parent-chain resolver (classifies embedded parents as mainnet/trial) ─────
# Explorer API base. litecoinspace.org works key-less, with lib:
#   https://litecoinspace.org/api
PSOB_CCNODES_BASE=https://litecoinspace.org/api
# Optional secondary explorer tried only on transport failure of the primary
# (empty/unset = no fallback — nothing is hardcoded).
# PSOB_CCNODES_FALLBACK_BASE=https://another-explorer.example/api
# Parent chain slug — validated at startup (lowercased; must be "litecoin" or
# "bitcoin"). A typo here would silently mis-classify parents as "trial", so it
# fails loudly instead of failing quiet.
PSOB_PARENT_CHAIN=litecoin
CCNODES_API_KEY=

# ─── Tuning (optional) ─────────────────────────────────────────────────────────
PSOB_MAX_BATCH=64
PSOB_POLL_INTERVAL_SECS=15
# Global start height for fresh DBs when per-chain START_HEIGHT is absent.
PSOB_START_HEIGHT=1000000

# HTTP policy (Electrs fetch + resolver).
PSOB_HTTP_TIMEOUT_SECS=30
PSOB_HTTP_CONCURRENCY=8
PSOB_MAX_RETRIES=5
PSOB_RETRY_BASE_MS=500
PSOB_RETRY_MAX_MS=30000
# Minimum gap between requests to one Electrs host (0 = unlimited).
PSOB_RATE_LIMIT_MS=0

# ─── REST API ──────────────────────────────────────────────────────────────────
PSOB_BIND_ADDR=0.0.0.0:8080
# Comma-separated origins; `*` allows all.
PSOB_CORS_ORIGINS=*
# Alternative to PSOB_BIND_ADDR:
# PSOB_PORT=8080

# ─── P2P (libp2p gossip) ───────────────────────────────────────────────────────
PSOB_P2P_PORT=9000
PSOB_P2P_BIND=0.0.0.0
PSOB_BOOTSTRAP_NODES=
# Set anything to disable mDNS discovery.
# PSOB_DISABLE_MDNS=1

# ─── Optional TOML config file (instead of these env vars) ────────────────────
# PSOB_CONFIG=./psob-indexer.toml

# ─── Monitoring ────────────────────────────────────────────────────────────────
# Prometheus metrics are always served at GET /metrics (text exposition,
# psob_indexer_* namespace): HTTP counters/histograms, per-chain ingest
# counters, classification counters, and DB gauges refreshed per scrape.

# Log level filter.
RUST_LOG=psob_indexer=info,chain_rpc=info
